---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import Placeholder from '../components/Placeholder.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';
import { getProjects } from '../data/content';

const projects = await getProjects();
const featured = projects.slice(0, 3);
---

<Base home wide>
  <section slot="hero" class:list={['hero', { 'hero-empty': !site.heroImage }]} style={site.heroImage ? `--hero-img: url('${site.heroImage}')` : undefined}>
    <div class="wrap hero-inner">
      <div class="photo">
        <Placeholder src={site.photo} alt={site.name} label="Your photo" ratio="1 / 1" round />
      </div>
      <div>
        <h1>{site.name}</h1>
        <p class="tagline">{site.description}</p>
        <p class="actions">
          <a class="btn primary" href="/projects/">See projects</a>
          <a class="btn" href="/about/">About me</a>
        </p>
      </div>
    </div>
    {!site.heroImage && <span class="hero-label">Background image placeholder</span>}
  </section>

  <div class="prose">
    <!-- DRAFT intro: rewrite in your own words. -->
    <p>
      I'm a mechanical engineer. Most of my work is finite element analysis, and a growing part of it is
      writing code so I do less of it by hand: scripted models, optimisation loops, and language models
      connected to engineering tools.
    </p>
    <p>This is where I write up what I build, with the numbers, including the parts that didn't work.</p>
  </div>

  <h2 class="section-title">Recent projects</h2>
  <ul class="cards">
    {featured.map((p) => <ProjectCard project={p} />)}
  </ul>
  {projects.length > featured.length && <p><a href="/projects/">All projects →</a></p>}

  <h2 class="section-title">Contact</h2>
  <Contact />
</Base>

<style>
  .hero {
    position: relative;
    color: var(--brand-ink);
    background:
      linear-gradient(120deg, rgba(8, 46, 44, 0.88), rgba(15, 71, 68, 0.6)),
      var(--hero-img) center / cover no-repeat,
      var(--brand);
  }
  /* Until a background image is set: a blueprint-style grid fills the space. */
  .hero-empty {
    background:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.06) 0 1px, transparent 1px 32px),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.06) 0 1px, transparent 1px 32px),
      linear-gradient(120deg, #0a3533, #17706a);
  }
  .hero-inner { display: flex; align-items: center; gap: 2rem; padding-top: 3.5rem; padding-bottom: 3.5rem; }
  .photo { flex: 0 0 9rem; }
  .photo :global(.ph) { color: var(--brand-ink); border-color: rgba(255, 255, 255, 0.5); background: rgba(255, 255, 255, 0.08); }
  .photo :global(.ph-img) { border: 3px solid var(--brand-ink); }
  h1 { margin: 0 0 0.4rem; font-size: 2.2rem; }
  .tagline { margin: 0 0 1.25rem; font-size: 1.1rem; opacity: 0.9; max-width: 34rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0; }
  .btn {
    display: inline-block;
    padding: 0.45rem 1rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    color: var(--brand-ink);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .btn:hover { background: rgba(255, 255, 255, 0.12); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 600; }
  .btn.primary:hover { filter: brightness(1.08); }
  .hero-label {
    position: absolute;
    right: 16px;
    bottom: 0.6rem;
    font-size: 0.75rem;
    opacity: 0.6;
    border: 1px dashed currentColor;
    border-radius: 4px;
    padding: 0.1rem 0.5rem;
  }
  .prose { max-width: 40rem; }
  @media (max-width: 36rem) {
    .hero-inner { flex-direction: column; align-items: flex-start; gap: 1.25rem; padding-top: 2.25rem; padding-bottom: 3rem; }
    .photo { flex-basis: auto; width: 7rem; }
    h1 { font-size: 1.8rem; }
  }
</style>

---
// Home page: a summary. Intro, selected work, what's in progress, a short About.
// Text comes from src/data/site.ts; projects from src/content/projects/.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Photo from '../components/Photo.astro';
import Status from '../components/Status.astro';
import Contact from '../components/Contact.astro';
import ProjectLink from '../components/ProjectLink.astro';
import { site, about, experience, education } from '../data/site';
import { getProjects, projectUrl, year, monthYear, defaultPreview } from '../data/projects';

const projects = await getProjects();
const reports = new Set((await getCollection('reports')).map((r) => r.id));

// Selected work: featured built projects (newest first); the first one is shown large.
const built = projects.filter((p) => p.data.status === 'built');
const featured = built.filter((p) => p.data.featured);
const [lead, ...others] = (featured.length ? featured : built).slice(0, 4);

const ongoingAll = projects.filter((p) => p.data.status !== 'built');
const ongoing = ongoingAll.slice(0, 5);

// Section numbers follow whichever sections have content.
const sections = [lead && 'work', ongoing.length && 'ongoing', 'about'].filter(Boolean);
const num = (id: string) => sections.indexOf(id) + 1;

const [now, before] = experience;
const school = education[0];
---

<Base page="home" image={await defaultPreview()}>
  <section class="intro wrap">
    <div class="inner ruled">
      <div>
        <h1 class="page-title">{site.name}</h1>
        <p class="role">{site.role}</p>
        <p class="lede">{site.intro}</p>
        <dl class="facts stack-narrow">
          <dt>Fields</dt>
          <dd>{site.focus}</dd>
          <dt>Contact</dt>
          <dd><Contact /></dd>
        </dl>
      </div>
      <div class="photo"><Photo sizes="(min-width: 48rem) 12rem, 7.5rem" /></div>
    </div>
  </section>

  {lead && (
    <section class="wrap" id="projects" aria-labelledby="work-title">
      <div class="sec ruled">
        <div class="sec-head">
          <h2 id="work-title"><span class="n">{num('work')}</span>Selected work</h2>
          <a class="btn" href="/projects/">All projects →</a>
        </div>

        <article class="lead">
          <figure>
            <Cover
              src={lead.data.cover}
              alt={lead.data.coverAlt}
              hint={lead.data.coverHint}
              eager
              widths={[480, 800, 1200]}
              sizes="(min-width: 64rem) 37rem, (min-width: 56rem) 55vw, 100vw"
            />
            {lead.data.caption && <figcaption><b>Fig. 1</b>{lead.data.caption}</figcaption>}
          </figure>
          <div>
            <p class="meta">
              {lead.data.fields.join(' · ')}{lead.data.date && <> · {monthYear(lead.data.date)}</>} · <Status status={lead.data.status} />
            </p>
            <h3>{lead.data.title}</h3>
            <p>{lead.data.summary}</p>
            {lead.data.numbers ? (
              <dl class="numbers">
                {lead.data.numbers.map((n) => (
                  <div><dt>{n.value}</dt><dd>{n.label}</dd></div>
                ))}
              </dl>
            ) : (
              lead.data.result && <p class="result">{lead.data.result}</p>
            )}
            <p class="links">
              {projectUrl(lead) && <a class="btn" href={projectUrl(lead)}>Read the write-up</a>}
              {reports.has(lead.id) && projectUrl(lead) && <a class="btn" href={`/projects/${lead.id}/report/`}>Technical report</a>}
              {lead.data.repo && <a class="btn" href={lead.data.repo}>Code</a>}
            </p>
          </div>
        </article>

        {others.length > 0 && (
          <div class="grid">
            {others.map((p) => (
              <article>
                <Cover
                  src={p.data.cover}
                  alt={p.data.coverAlt}
                  hint={p.data.coverHint}
                  frame="4 / 3"
                  widths={[400, 800]}
                  sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 45vw, 100vw"
                />
                <p class="meta">
                  {p.data.fields.join(' · ')}{year(p) && <> · {year(p)}</>} · <Status status={p.data.status} />
                </p>
                <h3>{p.data.title}</h3>
                <p class="summary">{p.data.summary}</p>
                {p.data.result && <p class="result">{p.data.result}</p>}
                {projectUrl(p) && <p class="open"><ProjectLink project={p} /></p>}
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  {ongoing.length > 0 && (
    <section class="wrap" id="in-progress" aria-labelledby="ongoing-title">
      <div class="sec ruled">
        <div class="sec-head">
          <h2 id="ongoing-title"><span class="n">{num('ongoing')}</span>In progress</h2>
          {ongoingAll.length > ongoing.length && <a class="btn" href="/projects/">See all {ongoingAll.length} →</a>}
        </div>
        <table class="list">
          <thead><tr><th>Project</th><th>Field</th><th>Status</th></tr></thead>
          <tbody>
            {ongoing.map((p) => (
              <tr>
                <td>
                  <span class="title">{p.data.title}</span>
                  <span class="sub">{p.data.summary}</span>
                  {projectUrl(p) && <span class="open"><ProjectLink project={p} /></span>}
                </td>
                <td>{p.data.fields.join(', ')}</td>
                <td><Status status={p.data.status} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="wrap" id="about" aria-labelledby="about-title">
    <div class="sec ruled">
      <div class="sec-head">
        <h2 id="about-title"><span class="n">{num('about')}</span>About</h2>
        <a class="btn" href="/about/">More about me →</a>
      </div>
      <div class="about">
        <p>{about[0]}</p>
        <dl class="kv">
          {now && <div><dt>{/Present$/i.test(now.dates) ? 'Now' : now.dates}</dt><dd>{now.role}, {now.company}</dd></div>}
          {before && <div><dt>Before</dt><dd>{before.role}, {before.company}</dd></div>}
          {school && <div><dt>Education</dt><dd>{school.degree}, {school.school}</dd></div>}
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Intro: name, role, intro line, fields and contact; photo on the right (on top on phones). */
  .inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; padding: 2.5rem 0 3rem; }
  .photo { width: 7.5rem; order: -1; }
  @media (min-width: 48rem) {
    .inner { grid-template-columns: minmax(0, 1fr) 12rem; gap: 3rem; padding-top: 3.5rem; }
    .photo { order: 0; width: auto; }
  }
  .role { margin: 0.5rem 0 0; font-size: 1.2rem; font-weight: 500; color: var(--accent); }
  .lede { margin: 1.25rem 0 0; max-width: 36rem; font-size: 1.15rem; line-height: 1.55; }
  .facts { margin: 2rem 0 0; display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: 0.5rem 1rem; max-width: 42rem; font-size: 0.95rem; }
  .facts dt { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); padding-top: 0.2rem; }
  .facts dd { margin: 0; }

  /* Lead project: figure left, text right on wide screens. */
  .lead { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  @media (min-width: 56rem) { .lead { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 3rem; align-items: start; } }
  h3 { font-size: 1.1rem; line-height: 1.3; margin: 0 0 0.5rem; }
  .lead h3 { font-size: 1.45rem; line-height: 1.25; letter-spacing: -0.01em; }
  .lead p { margin: 0 0 1rem; }
  .numbers { margin: 1.5rem 0; border-top: 1px solid var(--rule); }
  .numbers div { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 1rem; padding: 0.65rem 0; border-bottom: 1px solid var(--rule); }
  .numbers dt { font-family: var(--mono); font-size: 1.1rem; font-weight: 500; line-height: 1.4; font-variant-numeric: tabular-nums; }
  .numbers dd { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.5; }
  @media (max-width: 22em) { .numbers div { grid-template-columns: minmax(0, 1fr); gap: 0.1rem; } }
  .links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .result { font-weight: 500; }

  /* Other selected projects: figures in a grid. */
  .grid { display: grid; gap: 2.5rem 2rem; margin-top: 3.5rem; grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr)); }
  .grid .meta { margin-top: 0.9rem; }
  .grid p { margin: 0; font-size: 0.95rem; }
  .grid .summary { color: var(--muted); }
  .grid .result { margin-top: 0.35rem; }
  .grid .open { margin-top: 0.75rem; }

  /* In-progress list: a table on wide screens, stacked rows on phones. */
  .list { width: 100%; border-collapse: collapse; }
  .list th { text-align: left; font-family: var(--mono); font-weight: 400; font-size: 0.78rem; color: var(--muted); padding: 0 1.5rem 0.6rem 0; border-bottom: 1px solid var(--rule-strong); }
  .list td { padding: 0.85rem 1.5rem 0.85rem 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .list td:first-child { width: 55%; }
  .list .title { font-weight: 500; color: var(--text); }
  .list .open { display: block; margin-top: 0.5rem; }
  .list .sub { display: block; color: var(--muted); font-size: 0.92rem; }
  @media (max-width: 40rem) {
    .list thead { display: none; }
    .list, .list tbody, .list tr { display: block; }
    .list tr { padding: 0.9rem 0; border-bottom: 1px solid var(--rule); }
    .list td { display: inline; border: 0; padding: 0; font-family: var(--mono); font-size: 0.78rem; color: var(--muted); margin-right: 1rem; }
    .list td:first-child { display: block; width: auto; margin: 0 0 0.3rem; font-family: var(--sans); font-size: 1rem; color: var(--text); }
  }

  .about { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem 3rem; }
  @media (min-width: 56rem) { .about { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }
  .about > p { margin: 0; max-width: 38rem; }
</style>

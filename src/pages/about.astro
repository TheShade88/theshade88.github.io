---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import Placeholder from '../components/Placeholder.astro';
import { site } from '../data/site';

// DRAFT: every entry below is a placeholder to replace with your own details.
const experience = [
  { role: 'Job title', org: 'Company', when: 'Year – Present', note: 'One or two lines on what you worked on and the result.' },
  { role: 'Job title', org: 'Company', when: 'Year – Year', note: 'One or two lines on what you worked on and the result.' },
];
const education = [{ degree: 'Degree, subject', org: 'University', when: 'Year' }];
const skills = ['Finite element analysis', 'CalculiX', 'Structural optimisation', 'Add a skill', 'Add a tool'];
---

<Base title="About" wide>
  <div class="intro">
    <div class="photo">
      <Placeholder src={site.photo} alt={site.name} label="Your photo" ratio="4 / 5" />
    </div>
    <div>
      <h1>About</h1>
      <p class="draft">
        A short paragraph in your own words: what you do, what kind of problems you like, and what you're looking for next.
      </p>
      <Contact />
      {!site.hasResume && <p class="muted small">Resume: add <code>public/resume.pdf</code> and set <code>hasResume: true</code> in <code>src/data/site.ts</code>.</p>}
    </div>
  </div>

  <div class="cols">
    <section>
      <h2 class="section-title">Experience</h2>
      <ol class="timeline">
        {experience.map((e) => (
          <li class="draft">
            <span class="when">{e.when}</span>
            <strong>{e.role}</strong> · {e.org}
            <p>{e.note}</p>
          </li>
        ))}
      </ol>

      <h2 class="section-title">Education</h2>
      <ol class="timeline">
        {education.map((e) => (
          <li class="draft">
            <span class="when">{e.when}</span>
            <strong>{e.degree}</strong> · {e.org}
          </li>
        ))}
      </ol>
    </section>

    <section>
      <h2 class="section-title">Skills and tools</h2>
      <ul class="chips">
        {skills.map((s) => <li>{s}</li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  .intro { display: grid; grid-template-columns: 14rem 1fr; gap: 2rem; align-items: start; margin-bottom: 1rem; }
  .intro h1 { margin-top: 0; }
  .draft { border-left: 3px dashed var(--rule-strong); padding-left: 0.8rem; color: var(--muted); }

  .cols { display: grid; grid-template-columns: 3fr 2fr; gap: 0 3rem; }

  .timeline { list-style: none; padding: 0; }
  .timeline li { margin-bottom: 1.2rem; }
  .timeline .when { display: block; font-size: 0.8rem; color: var(--accent); font-weight: 600; font-variant-numeric: tabular-nums; }
  .timeline p { margin: 0.2rem 0 0; font-size: 0.95rem; }

  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li { margin: 0; padding: 0.25rem 0.75rem; border-radius: 999px; background: var(--tint); border: 1px solid var(--rule); font-size: 0.9rem; }

  @media (max-width: 44rem) {
    .intro { grid-template-columns: 1fr; }
    .photo { width: 10rem; }
    .cols { grid-template-columns: 1fr; }
  }
</style>

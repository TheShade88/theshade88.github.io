---
// A project's technical report (report.md in the project folder), for projects that have a page.
import { getCollection, getEntry, render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import { getProjects, hasPage } from '../../../data/projects';

export async function getStaticPaths() {
  const withPage = new Set((await getProjects()).filter(hasPage).map((p) => p.id));
  const reports = await getCollection('reports', (r) => withPage.has(r.id));
  return reports.map((report) => ({ params: { id: report.id }, props: { report } }));
}

const { report } = Astro.props;
const project = await getEntry('projects', report.id);
const { Content, headings } = await render(report);
const title = headings.find((h) => h.depth === 1)?.text ?? 'Technical report';
---

<Article title={title} description={project?.data.summary} image={project?.data.preview ?? project?.data.cover}>
  <p slot="meta" class="meta">
    Technical report{project && <> · <a class="btn" href={`/projects/${report.id}/`}>Read the short version</a></>}
  </p>
  <Content />
</Article>

---
// A project's write-up page, for every project whose index.md has text below the frontmatter.
import { getCollection, render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import Status from '../../../components/Status.astro';
import { getProjects, hasPage, monthYear, type Project } from '../../../data/projects';

export async function getStaticPaths() {
  const projects = (await getProjects()).filter(hasPage);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { title, summary, date, repo, cover, preview, tags, fields, status } = project.data;
const report = (await getCollection('reports')).find((r) => r.id === project.id);
const { Content } = await render(project);
---

<Article title={title} description={summary} image={preview ?? cover}>
  <p slot="meta" class="meta top">
    <span>{fields.join(' · ')}</span>
    {date && <span>{monthYear(date)}</span>}
    <Status status={status} />
    {report && <a class="btn" href={`/projects/${project.id}/report/`}>Technical report</a>}
    {repo && <a class="btn" href={repo}>Code</a>}
    {tags.length > 0 && <span>Tools: {tags.join(', ')}</span>}
  </p>
  <Content />
</Article>

<style>
  .top { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1.25rem; margin-bottom: 1rem; }
</style>

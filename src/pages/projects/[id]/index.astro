---
import { getEntry, render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import { getProjects, monthYear } from '../../../data/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, date, repo, image, tags } = project.data;
const report = await getEntry('reports', project.id);
const { Content } = await render(project);
---

<Article title={title} description={summary} image={image}>
  <p slot="meta" class="meta">
    <span>{monthYear(date)}</span>
    {report && <a href={`/projects/${project.id}/report/`}>Technical report</a>}
    {repo && <a href={repo}>Code</a>}
    {tags.length > 0 && <span class="mono">{tags.join(' · ')}</span>}
  </p>
  <Content />
</Article>

<style>
  .meta { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; font-size: 0.85rem; color: var(--muted); margin: 0 0 0.75rem; }
  .meta .mono { font-size: 0.78rem; color: var(--accent); }
</style>

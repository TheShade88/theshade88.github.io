---
// Layout for long-form pages: project write-ups and technical reports.
import type { ImageMetadata } from 'astro';
import Base from './Base.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
}

const props = Astro.props;
---

<Base {...props} page="projects" article>
  <div class="wrap">
    <div class="article">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/projects/">Projects</a> /</nav>
      <slot name="meta" />
      <article class="prose">
        <slot />
      </article>
      <footer class="author">
        <p><strong>{site.name}</strong>, {site.role.toLowerCase()}. <a href="/projects/">More projects</a></p>
        <p><Contact /></p>
      </footer>
    </div>
  </div>
</Base>

<script>
  // Wide tables in write-ups scroll sideways on phones. tabindex lets keyboard users reach them
  // and scroll with the arrow keys.
  document.querySelectorAll<HTMLElement>('.prose table').forEach((t) => (t.tabIndex = 0));
</script>

<style>
  .article { max-width: 44rem; margin: 0 auto; padding: 2rem 0 4rem; }
  .crumbs { font-size: 0.9rem; color: var(--muted); margin-bottom: 2.5rem; }
  .author { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); font-size: 0.95rem; }
  .author p { margin: 0 0 0.6rem; }
</style>

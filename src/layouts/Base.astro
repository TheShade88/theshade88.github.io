---
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource-variable/ibm-plex-sans/wght-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string; // path under public/, used for link previews
  home?: boolean;
  wide?: boolean; // wider column for card grids; articles stay narrow
}

const { title, description = site.description, image, home = false, wide = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base);
const imageUrl = image && new URL(image, base);

const path = Astro.url.pathname;
const tabs = [
  { href: '/', label: 'Home', active: path === '/' },
  { href: '/projects/', label: 'Projects', active: path.startsWith('/projects') },
  { href: '/about/', label: 'About', active: path.startsWith('/about') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={home ? 'website' : 'article'} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <header class="site-header">
      <nav class="wrap" aria-label="Main">
        <a class="brand" href="/">{site.name}</a>
        <ul class="tabs">
          {tabs.map((t) => (
            <li><a href={t.href} aria-current={t.active ? 'page' : undefined}>{t.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <slot name="hero" />
    <main class:list={[wide ? 'wrap' : 'narrow']}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">© {new Date().getFullYear()} {site.name}</div>
    </footer>
  </body>
</html>

---
// The frame around every page: <head>, header with the page links, footer.
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource-variable/ibm-plex-sans/wght-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata; // link-preview image (LinkedIn etc.)
  page?: 'home' | 'projects' | 'about'; // which link in the header is current
  article?: boolean;
}

const { title, description = site.description, image, page, article = false } = Astro.props;
const links = [
  { id: 'home', href: '/', label: 'Home' },
  { id: 'projects', href: '/projects/', label: 'Projects' },
  { id: 'about', href: '/about/', label: 'About' },
];
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base);
const preview = image && (await getImage({ src: image, width: 1200, format: 'png' }));
const imageUrl = preview && new URL(preview.src, base);
const updated = new Date().toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <div class:list={['bar ruled', { 'no-brand': page === 'home' }]}>
        {page !== 'home' && <a class="brand" href="/">{site.name}</a>}
        <nav class="nav" aria-label="Main">
          <ul>
            {links.map((l) => (
              <li><a href={l.href} aria-current={l.id === page ? 'page' : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <p>
        {site.name} · <a href={site.links.linkedin}>LinkedIn</a> · <a href={site.links.github}>GitHub</a>
        {site.email && <> · <a href={`mailto:${site.email}`}>Email</a></>} · Updated {updated}
      </p>
    </footer>
  </body>
</html>
